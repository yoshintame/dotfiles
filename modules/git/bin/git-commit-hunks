#!/usr/bin/env bash
# git-commit-hunks: apply patch(es) to ephemeral index and commit, race-safe via HEAD CAS.
# Usage: git-commit-hunks <message> <patch>...
set -uo pipefail

[ $# -lt 2 ] && { echo "Usage: git-commit-hunks <message> <patch>..." >&2; exit 2; }
MSG="$1"; shift
ERR=$(mktemp); trap "rm -f $ERR" EXIT

GIT_DIR=$(git rev-parse --git-dir)
i=0
while [ $i -lt 50 ]; do
    EXPECTED=$(git rev-parse HEAD)
    TMP=$(mktemp "$GIT_DIR/idx-hunks.XXXXXXXX")
    GIT_INDEX_FILE="$TMP" git read-tree "$EXPECTED" || { rm -f "$TMP"; exit 1; }

    APPLY_OK=1
    for patch in "$@"; do
        if ! GIT_INDEX_FILE="$TMP" git apply --cached "$patch" 2>"$ERR"; then
            cat "$ERR" >&2; rm -f "$TMP"; exit 1
        fi
    done

    TREE=$(GIT_INDEX_FILE="$TMP" git write-tree)
    NEW=$(echo "$MSG" | git commit-tree "$TREE" -p "$EXPECTED")

    if git update-ref HEAD "$NEW" "$EXPECTED" 2>"$ERR"; then
        rm -f "$TMP"; exit 0
    fi
    rm -f "$TMP"
    i=$((i+1))
    sleep 0.05
done
echo "git-commit-hunks: CAS retry exhausted after $i attempts" >&2
exit 1
