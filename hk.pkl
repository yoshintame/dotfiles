amends "package://github.com/yoshintame/hk-config/releases/download/v0.6.0/hk-config@0.6.0#/presets/nix.pkl"

local generated =
  List(
    "hosts/*/packages/**",
    "hosts/lasthaze-gaming/windows/autounattend*.xml",
    "modules/home/bat/config/theme/**",
    "modules/home/hammerspoon/config/Spoons/**",
    "modules/home/resticprofile/config/repo.key.tmpl",
    "modules/home/vscode/dump/**",
    "modules/home/warp/config/workflows/**",
    "modules/windows/windows-terminal/config/settings.json",
    "os/windows/packages/**",
  )

exclude = List("archive/**")

steps {
  ["trailing_whitespace"] {
    exclude = generated
  }
  ["newlines"] {
    exclude = generated
  }
  ["flake"] {
    check = "nix flake check --impure"
  }
  ["component-pointers"] {
    check =
      #"lock=$(git show :flake.lock | bun -e 'console.log(JSON.parse(await Bun.stdin.text()).nodes["karabiner-config"]?.locked.rev ?? "")') && { [ -z "$lock" ] || { link=$(git rev-parse -q --verify :modules/home/karabiner/config || true); [ "$lock" = "$link" ]; } || { echo "karabiner-config gitlink $link != flake.lock $lock" >&2; exit 1; }; }"#
  }
  ["darwin"] {
    check =
      "nix eval --impure --raw --option allow-import-from-derivation false .#darwinConfigurations.lasthaze-mbp.system.drvPath > /dev/null"
    profiles = List("slow")
  }
  ["shellcheck"] {
    glob = List("bootstrap.sh", "tests/tart/*.sh")
    check = "shellcheck --severity=warning {{ files }}"
  }
}
