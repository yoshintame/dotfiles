#!/usr/bin/env bun
import { existsSync, mkdirSync, readFileSync, statSync, writeFileSync } from "node:fs"
import { homedir } from "node:os"
import { basename, join } from "node:path"
import { defineCommand, runMain } from "citty"

function die(msg: string): never {
  process.stderr.write(`extract-images: ${msg}\n`)
  process.exit(1)
}

function parseBack(v: string): number {
  if (!/^\d+$/.test(v)) die(`--back must be a non-negative integer, got ${JSON.stringify(v)}`)
  return Number(v)
}

function parseIndices(spec: string): number[] {
  const out: number[] = []
  for (const token of spec.split(",")) {
    const p = token.trim()
    if (p === "") continue
    const range = p.match(/^(\d+)-(\d+)$/)
    if (range) {
      const lo = Number(range[1])
      const hi = Number(range[2])
      if (lo > hi) die(`invalid --indices range ${JSON.stringify(p)}: start > end`)
      for (let i = lo; i <= hi; i++) out.push(i)
    } else if (/^\d+$/.test(p)) {
      out.push(Number(p))
    } else {
      die(`invalid --indices token ${JSON.stringify(p)} (expected N or N-M)`)
    }
  }
  if (out.length === 0) die("--indices resolved to an empty set")
  return out
}

function parseNames(spec: string, expected: number): string[] {
  const names = spec
    .split(",")
    .map(s => s.trim())
    .filter(s => s !== "")
  if (names.length !== expected) {
    die(`--names lists ${names.length} name(s) but the selection has ${expected} image(s) — they must match one to one`)
  }
  for (const n of names) {
    if (n.includes("/") || n.includes("\\")) {
      die(`--names entry ${JSON.stringify(n)} must not contain a path separator`)
    }
  }
  return names
}

function withExt(name: string, ext: string): string {
  return name.toLowerCase().endsWith(`.${ext}`) ? name : `${name}.${ext}`
}

function hashCwd(cwd: string): string {
  return cwd.replace(/[\/.]/g, "-")
}

async function discoverTranscript(session: string | undefined): Promise<string> {
  const projectsRoot = join(homedir(), ".claude", "projects")
  if (!existsSync(projectsRoot)) die(`projects root not found: ${projectsRoot}`)
  const sessionId = session ?? process.env.CLAUDE_CODE_SESSION_ID

  if (sessionId) {
    for await (const p of new Bun.Glob(`**/${sessionId}.jsonl`).scan({ cwd: projectsRoot, absolute: true })) {
      return p
    }
    die(`session ${sessionId} set, but no ${sessionId}.jsonl found under ${projectsRoot}`)
  }

  const cwdDir = join(projectsRoot, hashCwd(process.cwd()))
  if (!existsSync(cwdDir)) {
    die(`no project dir for cwd ${process.cwd()} (expected ${cwdDir}); pass --session or set CLAUDE_CODE_SESSION_ID`)
  }
  const files: string[] = []
  for await (const p of new Bun.Glob("*.jsonl").scan({ cwd: cwdDir, absolute: true })) {
    files.push(p)
  }
  if (files.length === 0) die(`no .jsonl transcripts in ${cwdDir}; pass --session`)
  files.sort((a, b) => statSync(b).mtimeMs - statSync(a).mtimeMs)
  return files[0]!
}

type ImageBlock = { mediaType: string; data: string }
type ImageMessage = { line: number; images: ImageBlock[] }

function collectImageMessages(transcript: string): ImageMessage[] {
  const lines = readFileSync(transcript, "utf8").split("\n")
  const result: ImageMessage[] = []
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i]!
    if (!line.includes("image")) continue
    let obj: unknown
    try {
      obj = JSON.parse(line)
    } catch {
      process.stderr.write(`extract-images: warning: skipping unparseable transcript line ${i + 1}\n`)
      continue
    }
    const rec = obj as Record<string, unknown>
    if (rec.type !== "user" || rec.isSidechain === true) continue
    const message = rec.message as Record<string, unknown> | undefined
    if (!message || message.role !== "user") continue
    const content = message.content
    if (!Array.isArray(content)) continue
    if (content.some(b => (b as Record<string, unknown>)?.type === "tool_result")) continue
    const images: ImageBlock[] = []
    for (const block of content as Record<string, unknown>[]) {
      if (block?.type !== "image") continue
      const source = block.source as Record<string, unknown> | undefined
      if (
        !source ||
        source.type !== "base64" ||
        typeof source.data !== "string" ||
        typeof source.media_type !== "string"
      ) {
        const shape = source ? JSON.stringify({ ...source, data: "<omitted>" }) : String(source)
        die(
          `transcript line ${i + 1}: image block has unexpected shape (source=${shape}); ` +
            `transcript format may have changed — refusing to guess`,
        )
      }
      if (!source.media_type.startsWith("image/")) {
        die(`transcript line ${i + 1}: unexpected media_type ${JSON.stringify(source.media_type)} (not image/*)`)
      }
      images.push({ mediaType: source.media_type, data: source.data })
    }
    if (images.length > 0) result.push({ line: i + 1, images })
  }
  return result
}

function extFor(mediaType: string): string {
  const subtype = mediaType.slice("image/".length).toLowerCase()
  const remap: Record<string, string> = { jpeg: "jpg", "svg+xml": "svg" }
  const ext = remap[subtype] ?? subtype
  if (!/^[a-z0-9]+$/.test(ext)) die(`cannot derive a file extension from media_type ${JSON.stringify(mediaType)}`)
  return ext
}

const main = defineCommand({
  meta: {
    name: "extract-images",
    description:
      "Decode images pasted into a Claude Code session to files on disk. Pasted images are not exposed to the agent as files, but persist byte-for-byte as base64 blocks in the session transcript; this reads them back out, byte-identical to the originals. Writes into <dir> (created if missing) and prints each path to stdout. Names come from --names, else default to <session-uuid>-<back>-<index>.<ext> — a coordinate you can feed straight back to --back/--indices. Defaults to every image from the most recent image-bearing user message.",
  },
  args: {
    dir: {
      type: "positional",
      required: true,
      description: "Destination directory; created if missing",
    },
    names: {
      type: "string",
      description:
        "Comma-separated names for the selected images, in order; extension is added from media type. Default: <session-uuid>-<back>-<index>",
    },
    session: {
      type: "string",
      description: "Session id to read (default: $CLAUDE_CODE_SESSION_ID, else newest transcript for the cwd)",
    },
    back: {
      type: "string",
      description: "Nth image-bearing user message from the end: 0 = most recent (default), 1 = the one before it",
    },
    indices: {
      type: "string",
      description: "0-based image indices within the chosen message, e.g. 0,2 or 1-3 (default: all)",
    },
    "dry-run": {
      type: "boolean",
      description: "Report what would be written; write nothing",
    },
    json: {
      type: "boolean",
      description: "Emit a JSON array [{index, path, mediaType, bytes}] instead of bare paths",
    },
  },
  async run({ args }) {
    const back = args.back === undefined ? 0 : parseBack(String(args.back))
    const indices = args.indices === undefined ? undefined : parseIndices(String(args.indices))

    const transcript = await discoverTranscript(typeof args.session === "string" ? args.session : undefined)
    const messages = collectImageMessages(transcript)
    if (messages.length === 0) die(`no user message with pasted images found in ${transcript}`)
    if (back >= messages.length) {
      die(`--back ${back} out of range: only ${messages.length} image-bearing user message(s) in transcript`)
    }
    const chosen = messages[messages.length - 1 - back]!

    let selection: { srcIndex: number; block: ImageBlock }[]
    if (indices) {
      const max = chosen.images.length - 1
      for (const idx of indices) {
        if (idx < 0 || idx > max) {
          die(`--indices ${idx} out of range: chosen message has ${chosen.images.length} image(s) (valid 0..${max})`)
        }
      }
      selection = indices.map(idx => ({ srcIndex: idx, block: chosen.images[idx]! }))
    } else {
      selection = chosen.images.map((block, srcIndex) => ({ srcIndex, block }))
    }

    const dryRun = args["dry-run"] === true
    const sessionId = basename(transcript, ".jsonl")
    const names = args.names === undefined ? undefined : parseNames(String(args.names), selection.length)
    if (!dryRun && !existsSync(args.dir)) mkdirSync(args.dir, { recursive: true })

    const written: { index: number; path: string; mediaType: string; bytes: number }[] = []
    selection.forEach(({ srcIndex, block }, n) => {
      const ext = extFor(block.mediaType)
      const base = names ? withExt(names[n]!, ext) : `${sessionId}-${back}-${srcIndex}.${ext}`
      const path = join(args.dir, base)
      const buf = Buffer.from(block.data, "base64")
      if (buf.length === 0) die(`image at index ${srcIndex} decoded to 0 bytes — refusing to write an empty file`)
      if (!dryRun) writeFileSync(path, buf)
      written.push({ index: srcIndex, path, mediaType: block.mediaType, bytes: buf.length })
    })

    if (args.json === true) {
      process.stdout.write(`${JSON.stringify(written, null, 2)}\n`)
    } else {
      for (const w of written) process.stdout.write(`${w.path}\n`)
    }
    process.stderr.write(
      `extract-images: ${dryRun ? "would extract" : "extracted"} ${written.length} image(s) from ${transcript} ` +
        `(transcript line ${chosen.line})\n`,
    )
  },
})

runMain(main)
