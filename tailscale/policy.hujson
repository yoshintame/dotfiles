{
	"tagOwners": {
		"tag:homelab":   ["m.ivanov0427@gmail.com"],
		"tag:edge":      ["m.ivanov0427@gmail.com"],
		"tag:ru-exit":   ["m.ivanov0427@gmail.com"],
		"tag:proxy-vps": ["m.ivanov0427@gmail.com"],
	},

	"autoApprovers": {
		"routes": {
			"0.0.0.0/0": ["tag:ru-exit"],
			"::/0":       ["tag:ru-exit"],
		},
	},

	"nodeAttrs": [
		{
			"target": ["*"],
			"app": {
				"tailscale.com/app-connectors": [
					{
						"name":       "russian-services",
						"connectors": ["tag:ru-exit"],
						"domains": [
							"gosuslugi.ru",
							"*.gosuslugi.ru",
							"mos.ru",
							"*.mos.ru",
							"emias.info",
							"*.emias.info",
						],
						"routes": [
							"109.207.0.0/20",
							"212.11.128.0/19",
							"94.79.51.0/24",
							"213.59.253.0/24",
							"213.59.254.0/24",
							"82.202.189.0/24",
							"212.45.30.0/24",
							"77.238.101.0/24",
							"84.201.152.0/24",
						],
					},
				],
			},
		},
	],

	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:edge"],
			"dst": ["tag:homelab"],
			"ip": [
				"tcp:443",
				"tcp:9090",
				"tcp:3100",
				"tcp:9093",
				"icmp:*",
			],
		},
		{
			"src": ["tag:homelab"],
			"dst": ["tag:edge"],
			"ip":  ["tcp:8080"],
		},
		{
			"src": ["m.ivanov0427@gmail.com"],
			"dst": ["tag:homelab"],
			"ip":  ["tcp:22"],
		},
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["m.ivanov0427@gmail.com"],
			"dst":    ["tag:homelab"],
			"users":  ["yoshintame", "root"],
		},
		{
			"action": "accept",
			"src":    ["m.ivanov0427@gmail.com"],
			"dst":    ["tag:ru-exit"],
			"users":  ["root"],
		},
	],
}
