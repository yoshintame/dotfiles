#!/usr/bin/env bun
import {
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  renameSync,
  rmSync,
  statSync,
  writeFileSync,
} from 'node:fs'
import { homedir } from 'node:os'
import { basename, join } from 'node:path'
import { defineCommand, runMain } from 'citty'
import { $ } from 'dax-sh'
import { z } from 'zod'

const archiveNamesPath = join(import.meta.dir, '..', 'archive-names.yaml')

const archiveNamesSchema = z.record(
  z.string().regex(/^[a-z0-9-]+$/),
  z.record(z.string(), z.string().regex(/^[a-z0-9-]+$/)),
)

const slugsByOriginalNameByService = loadArchiveNames()
const services = Object.keys(slugsByOriginalNameByService)

interface Archive {
  path: string
  originalName: string
  slug: string
  sha256: string
  bytes: number
}

interface ManifestEntry {
  original: string
  sha256: string
  bytes: number
  files: number
}

interface Manifest {
  service: string
  date: string
  archives: Record<string, ManifestEntry>
}

const main = defineCommand({
  meta: {
    name: 'data-export-import',
    description:
      'Unpack a service data export from Downloads into ~/Backups/remote/<service>/<date>/<slug>/ under stable kebab-case names',
  },
  args: {
    service: { type: 'positional', required: true, description: services.join(' | ') },
    from: { type: 'string', default: join(homedir(), 'Downloads'), description: 'Folder with the downloaded archives' },
    to: { type: 'string', default: join(homedir(), 'Backups', 'remote'), description: 'Root of the remote dumps' },
    date: { type: 'string', default: getToday(), description: 'Export date, YYYY-MM-DD' },
    'dry-run': { type: 'boolean', default: false, description: 'Print the plan without touching files' },
    keep: { type: 'boolean', default: false, description: 'Keep the source archives after unpacking' },
  },
  async run({ args }) {
    const service = args.service
    const slugsByOriginalName = getSlugsByOriginalName(service)
    if (!/^\d{4}-\d{2}-\d{2}$/.test(args.date)) die(`--date must be YYYY-MM-DD, got ${JSON.stringify(args.date)}`)

    const { archives, duplicates, unmatched } = await findArchives({ slugsByOriginalName, from: args.from })
    if (archives.length === 0) die(`no ${service} archives found in ${args.from}`)

    const target = join(args.to, service, args.date)
    const knownNames = Object.keys(slugsByOriginalName)
    const missing = knownNames.filter((name) => !archives.some((archive) => archive.originalName === name))

    printPlan({ archives, duplicates, unmatched, missing, target })
    if (args['dry-run']) return

    mkdirSync(target, { recursive: true })
    const manifest = readManifest({ target, service, date: args.date })

    for (const archive of archives) {
      manifest.archives[archive.slug] = await importArchive({ archive, target })
      console.log(`unpacked  ${archive.slug}  (${manifest.archives[archive.slug].files} files)`)
    }

    writeFileSync(join(target, 'manifest.json'), `${JSON.stringify(manifest, null, 2)}\n`)

    if (args.keep) return

    for (const path of [...archives.map((archive) => archive.path), ...duplicates]) rmSync(path)
    console.log(`removed ${archives.length + duplicates.length} source archives from ${args.from}`)
  },
})

void runMain(main)

interface FindArchivesInput {
  slugsByOriginalName: Record<string, string>
  from: string
}

async function findArchives({ slugsByOriginalName, from }: FindArchivesInput) {
  const archivesBySlug = new Map<string, Archive>()
  const duplicates: string[] = []
  const unmatched: string[] = []

  const fileNames = readdirSync(from)
    .filter((name) => name.endsWith('.zip'))
    .sort()
  const orderedFileNames = [
    ...fileNames.filter((name) => !isDownloadCopy(name)),
    ...fileNames.filter((name) => isDownloadCopy(name)),
  ]

  for (const fileName of orderedFileNames) {
    const originalName = getOriginalName(fileName)
    const slug = slugsByOriginalName[originalName]
    if (slug === undefined) {
      unmatched.push(fileName)
      continue
    }

    const path = join(from, fileName)
    const archive = { path, originalName, slug, sha256: await getSha256(path), bytes: statSync(path).size }
    const existing = archivesBySlug.get(slug)
    if (existing === undefined) {
      archivesBySlug.set(slug, archive)
      continue
    }
    if (existing.sha256 !== archive.sha256) die(`${basename(existing.path)} and ${fileName} differ, keep one of them`)

    duplicates.push(path)
  }

  return { archives: [...archivesBySlug.values()], duplicates, unmatched }
}

interface PrintPlanInput {
  archives: Archive[]
  duplicates: string[]
  unmatched: string[]
  missing: string[]
  target: string
}

function printPlan({ archives, duplicates, unmatched, missing, target }: PrintPlanInput) {
  console.log(`target    ${target}`)
  for (const archive of archives) console.log(`import    ${archive.originalName}  ->  ${archive.slug}`)
  for (const path of duplicates) console.log(`duplicate ${basename(path)}  (identical copy, removed with the sources)`)
  for (const name of missing) console.log(`missing   ${name}`)
  for (const name of unmatched) console.log(`skip      ${name}`)
}

interface ReadManifestInput {
  target: string
  service: string
  date: string
}

function readManifest({ target, service, date }: ReadManifestInput): Manifest {
  const path = join(target, 'manifest.json')
  if (!existsSync(path)) return { service, date, archives: {} }

  return JSON.parse(readFileSync(path, 'utf8')) as Manifest
}

interface ImportArchiveInput {
  archive: Archive
  target: string
}

async function importArchive({ archive, target }: ImportArchiveInput): Promise<ManifestEntry> {
  const destination = join(target, archive.slug)
  if (existsSync(destination)) die(`${destination} already exists`)

  const partial = `${destination}.partial`
  rmSync(partial, { recursive: true, force: true })
  await $`ditto -x -k ${archive.path} ${partial}`
  await extractNestedArchives(partial)
  renameSync(partial, destination)

  return {
    original: basename(archive.path),
    sha256: archive.sha256,
    bytes: archive.bytes,
    files: listFiles(destination).length,
  }
}

async function extractNestedArchives(dir: string) {
  const nested = listFiles(dir).filter((path) => path.endsWith('.zip'))
  if (nested.length === 0) return

  for (const path of nested) {
    const destination = path.slice(0, -'.zip'.length)
    if (existsSync(destination)) die(`cannot unpack nested ${path}: ${destination} already exists`)
    await $`ditto -x -k ${path} ${destination}`
    rmSync(path)
  }

  await extractNestedArchives(dir)
}

function listFiles(dir: string) {
  return readdirSync(dir, { recursive: true, encoding: 'utf8' })
    .map((relative) => join(dir, relative))
    .filter((path) => statSync(path).isFile())
}

function getOriginalName(fileName: string) {
  return fileName
    .normalize('NFC')
    .replace(/\.zip$/, '')
    .replace(downloadCopySuffix, '')
}

const downloadCopySuffix = / \(\d+\)$/

function isDownloadCopy(fileName: string) {
  return downloadCopySuffix.test(fileName.replace(/\.zip$/, ''))
}

async function getSha256(path: string) {
  const hasher = new Bun.CryptoHasher('sha256')
  for await (const chunk of Bun.file(path).stream()) hasher.update(chunk)

  return hasher.digest('hex')
}

function getSlugsByOriginalName(service: string) {
  const slugsByOriginalName = slugsByOriginalNameByService[service]
  if (slugsByOriginalName === undefined) {
    die(`unknown service ${JSON.stringify(service)}, expected ${services.join(' | ')} (from ${archiveNamesPath})`)
  }

  return Object.fromEntries(
    Object.entries(slugsByOriginalName).map(([originalName, slug]) => [originalName.normalize('NFC'), slug]),
  )
}

function loadArchiveNames() {
  const parsed = archiveNamesSchema.safeParse(Bun.YAML.parse(readFileSync(archiveNamesPath, 'utf8')))
  if (!parsed.success) die(`invalid ${archiveNamesPath}: ${z.prettifyError(parsed.error)}`)

  return parsed.data
}

function getToday() {
  return new Date().toLocaleDateString('sv-SE')
}

function die(message: string): never {
  process.stderr.write(`data-export-import: ${message}\n`)
  process.exit(1)
}
