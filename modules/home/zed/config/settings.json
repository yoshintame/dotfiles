// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Symbols Icon Theme"
    },
    "proxy": "",
    "use_system_window_tabs": false,
    "bottom_dock_layout": "full",
    "diff_view_style": "split",
    "debugger": {
        "button": false,
    },
    "title_bar": {
        "button_layout": "platform_default",
    },
    "use_system_prompts": false,
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "outline_panel": {
        "button": true,
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "right",
    },
    "agent": {
        "dock": "left",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "file_icons": true,
        "tree_view": true,
        "dock": "left",
        "sort_by_path": true,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "terminal": {
        "env": {},
        "font_size": 14.0,
        "font_family": "GeistMono Nerd Font Mono",
        "cursor_shape": "bar",
        "blinking": "on",
    },
    "project_panel": {
        "dock": "left",
        "hide_gitignore": true,
        "auto_fold_dirs": false,
    },
    "base_keymap": "VSCode",
    "multi_cursor_modifier": "cmd_or_ctrl",
    "sticky_scroll": {
        "enabled": false,
    },
    "vertical_scroll_margin": 5.0,
    "minimap": {
        "show": "never",
        "thumb": "always",
        "max_width_columns": 120,
    },
    "hover_popover_delay": 200,
    "cursor_shape": "bar",
    "max_tabs": 6,
    "use_system_path_prompts": false,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "buffer_font_family": "FiraCode Nerd Font",
    "colorize_brackets": false,
    "completions": {
        "words": "disabled",
    },
    "auto_indent_on_paste": true,
    "linked_edits": true,
    "show_whitespaces": "boundary",
    "show_edit_predictions": true,
    "ensure_final_newline_on_save": true,
    "preferred_line_length": 1000,
    "soft_wrap": "bounded",
    "tab_size": 4,
    "ui_font_size": 16,
    "buffer_font_size": 12.0,
    "theme": {
        "mode": "dark",
        "light": "Ayu Light",
        "dark": "True Vibrant (Xcode)",
    },
}
