#!/usr/bin/env bash
# git-commit-atomic: stage files and apply patches into one commit, with two
# execution modes:
#
#   default (no --auto)   delegate to `git commit -e` so the user's real
#                         editor opens for message review (same approach as
#                         the legacy git-commit-edit wrapper). git native
#                         flow runs pre-commit / commit-msg / post-commit
#                         hooks. Race-safety: .git/index.lock (git native);
#                         no CAS against HEAD movement.
#
#   --auto                build the commit on top of HEAD in an ephemeral
#                         GIT_INDEX_FILE under $GIT_DIR, then advance HEAD
#                         via atomic compare-and-swap (commit-tree +
#                         update-ref HEAD <new> <expected>). On lost CAS
#                         retry with the new HEAD snapshot. Hooks are NOT
#                         run (plumbing flow).
#
# Usage:
#   git-commit-atomic [flags] <message> [<file>...] [-- <patch>...]
#
# Files (positional before `--`) are staged whole from the worktree.
# Patches (positional after `--`) are applied via `git apply --cached`.
#
# Editor resolution (default mode): git config core.editor → $VISUAL →
# $EDITOR. The script overrides GIT_EDITOR for the `git commit -e` invocation
# so the Claude Code GIT_EDITOR=true sandbox is bypassed.
#
# Supported flags (must precede the message):
#   -C <path>, --repo <path>        chdir into <path> before committing.
#                                   Use this instead of `git -C <path>
#                                   commit-atomic ...` to avoid the
#                                   subcommand-token-merge regenerate failure
#                                   mode (kitten/feat-base-ui-combobox class).
#   --auto                          take the CAS path; skip editor preview
#   -s, --signoff                   append Signed-off-by trailer
#   -S, --gpg-sign[=<keyid>]        GPG-sign the commit
#   -n, --no-verify                 in --auto: no-op (no hooks anyway)
#                                   in editor mode: forwarded to git commit
#   --author "Name <email>"         override commit author (GIT_AUTHOR_*)
#   --date <when>                   override author date (GIT_AUTHOR_DATE)
#   --allow-empty-message           don't abort on empty post-edit message
#
# Unknown flags are rejected with exit 2.

set -uo pipefail

usage() {
    cat >&2 <<'USAGE'
Usage: git-commit-atomic [flags] <message> [<file>...] [-- <patch>...]
See: head git-commit-atomic for the supported flag list.
USAGE
    exit 2
}

AUTO=0
SIGNOFF=0
GPG_SIGN=()
ALLOW_EMPTY_MSG=0
NO_VERIFY=0
AUTHOR=""
DATE=""
REPO=""

while [ $# -gt 0 ]; do
    case "$1" in
        -C) REPO="${2:-}"; shift 2 ;;
        --repo) REPO="${2:-}"; shift 2 ;;
        --repo=*) REPO="${1#--repo=}"; shift ;;
        --auto) AUTO=1; shift ;;
        -s|--signoff) SIGNOFF=1; shift ;;
        -S) GPG_SIGN=(-S); shift ;;
        -S*) GPG_SIGN=("$1"); shift ;;
        --gpg-sign) GPG_SIGN=(-S); shift ;;
        --gpg-sign=*) GPG_SIGN=("-S${1#--gpg-sign=}"); shift ;;
        -n|--no-verify) NO_VERIFY=1; shift ;;
        --allow-empty-message) ALLOW_EMPTY_MSG=1; shift ;;
        --author=*) AUTHOR="${1#--author=}"; shift ;;
        --author) AUTHOR="${2:-}"; shift 2 ;;
        --date=*) DATE="${1#--date=}"; shift ;;
        --date) DATE="${2:-}"; shift 2 ;;
        -*) echo "git-commit-atomic: unsupported flag: $1" >&2; exit 2 ;;
        *) break ;;
    esac
done

if [ -n "$REPO" ]; then
    cd "$REPO" || { echo "git-commit-atomic: cannot chdir to $REPO" >&2; exit 1; }
fi

[ $# -lt 1 ] && usage
MSG="$1"; shift

FILES=()
PATCHES=()
seen_dashdash=0
for arg in "$@"; do
    if [ "$arg" = "--" ]; then
        seen_dashdash=1
        continue
    fi
    if [ "$seen_dashdash" = 1 ]; then
        PATCHES+=("$arg")
    else
        FILES+=("$arg")
    fi
done

if [ ${#FILES[@]} -eq 0 ] && [ ${#PATCHES[@]} -eq 0 ]; then
    echo "git-commit-atomic: no files or patches specified" >&2
    exit 2
fi

if [ -n "$AUTHOR" ]; then
    GIT_AUTHOR_NAME="${AUTHOR% <*}"
    rest="${AUTHOR##*<}"
    GIT_AUTHOR_EMAIL="${rest%>}"
    if [ "$GIT_AUTHOR_NAME" = "$AUTHOR" ] || [ -z "$GIT_AUTHOR_EMAIL" ]; then
        echo "git-commit-atomic: --author must be in 'Name <email>' format" >&2
        exit 2
    fi
    export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL
fi
[ -n "$DATE" ] && export GIT_AUTHOR_DATE="$DATE"

ERR=$(mktemp "${TMPDIR:-/tmp}/gca.XXXXXX")
trap 'rm -f "$ERR"' EXIT

if [ "$AUTO" -eq 0 ]; then
    # Editor mode: delegate to `git commit -e`. Mirrors the proven
    # git-commit-edit pattern: real editor resolved from core.editor /
    # $VISUAL / $EDITOR, then GIT_EDITOR overridden so git itself launches it
    # (correct subprocess + TTY handling instead of our own eval).
    EDITOR_CMD=$(git config --get core.editor 2>/dev/null || echo "")
    EDITOR_CMD="${EDITOR_CMD:-${VISUAL:-${EDITOR:-}}}"
    if [ -z "$EDITOR_CMD" ]; then
        echo "git-commit-atomic: no editor configured. Set core.editor / \$VISUAL / \$EDITOR, or pass --auto." >&2
        exit 1
    fi

    # Reset shared index to HEAD so unrelated staged entries from other
    # sessions / manual `git add`s don't leak into this commit. Mirrors
    # v5 commit-edit's "shared staging is disposable" stance.
    if ! (unset GIT_INDEX_FILE; git read-tree HEAD 2>"$ERR"); then
        cat "$ERR" >&2; exit 1
    fi

    if [ ${#FILES[@]} -gt 0 ]; then
        if ! git add -- "${FILES[@]}" 2>"$ERR"; then
            cat "$ERR" >&2; exit 1
        fi
    fi
    for patch in ${PATCHES[@]+"${PATCHES[@]}"}; do
        if ! git apply --cached "$patch" 2>"$ERR"; then
            cat "$ERR" >&2; exit 1
        fi
    done

    extras=()
    [ "$SIGNOFF" -eq 1 ] && extras+=(-s)
    [ ${#GPG_SIGN[@]} -gt 0 ] && extras+=("${GPG_SIGN[@]}")
    [ "$ALLOW_EMPTY_MSG" -eq 1 ] && extras+=(--allow-empty-message)
    [ "$NO_VERIFY" -eq 1 ] && extras+=(--no-verify)

    GIT_EDITOR="$EDITOR_CMD" git commit -e -m "$MSG" ${extras[@]+"${extras[@]}"}
    exit $?
fi

# --auto: CAS path. No editor, no hooks, full HEAD-move race-safety.
if [ "$SIGNOFF" -eq 1 ]; then
    name=$(git config --get user.name 2>/dev/null || echo "")
    email=$(git config --get user.email 2>/dev/null || echo "")
    if [ -n "$name" ] && [ -n "$email" ]; then
        MSG="$MSG"$'\n\n'"Signed-off-by: $name <$email>"
    fi
fi

GIT_DIR=$(git rev-parse --git-dir)
i=0
while [ $i -lt 50 ]; do
    EXPECTED=$(git rev-parse HEAD)
    TMP=$(mktemp "$GIT_DIR/idx-atomic.XXXXXXXX")
    if ! GIT_INDEX_FILE="$TMP" git read-tree "$EXPECTED" 2>"$ERR"; then
        cat "$ERR" >&2; rm -f "$TMP"; exit 1
    fi

    if [ ${#FILES[@]} -gt 0 ]; then
        if ! GIT_INDEX_FILE="$TMP" git add -- "${FILES[@]}" 2>"$ERR"; then
            cat "$ERR" >&2; rm -f "$TMP"; exit 1
        fi
    fi

    for patch in ${PATCHES[@]+"${PATCHES[@]}"}; do
        if ! GIT_INDEX_FILE="$TMP" git apply --cached "$patch" 2>"$ERR"; then
            cat "$ERR" >&2; rm -f "$TMP"; exit 1
        fi
    done

    TREE=$(GIT_INDEX_FILE="$TMP" git write-tree 2>"$ERR")
    if [ -z "$TREE" ]; then
        cat "$ERR" >&2; rm -f "$TMP"; exit 1
    fi

    NEW=$(echo "$MSG" | git commit-tree ${GPG_SIGN[@]+"${GPG_SIGN[@]}"} "$TREE" -p "$EXPECTED" 2>"$ERR")
    if [ -z "$NEW" ]; then
        cat "$ERR" >&2; rm -f "$TMP"; exit 1
    fi

    if git update-ref HEAD "$NEW" "$EXPECTED" 2>"$ERR"; then
        rm -f "$TMP"
        # Sync shared .git/index to the new HEAD so post-commit `git status`
        # reflects reality. CAS bypass doesn't touch shared index by itself.
        (unset GIT_INDEX_FILE; git read-tree HEAD 2>/dev/null) || true
        exit 0
    fi
    rm -f "$TMP"
    i=$((i+1))
    sleep 0.05
done
echo "git-commit-atomic: CAS retry exhausted after $i attempts" >&2
exit 1
