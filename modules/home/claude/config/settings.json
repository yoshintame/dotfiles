      "mcp__grafana-monitor__list_loki_label_names",
      "mcp__grafana-monitor__list_loki_label_values",
      "mcp__grafana-monitor__query_loki_stats",
      "mcp__grafana-monitor__query_loki_logs",
      "mcp__grafana-homelab__list_datasources",
      "mcp__grafana-homelab__list_prometheus_metric_names",
      "mcp__grafana-homelab__search_dashboards",
      "mcp__grafana-homelab__list_prometheus_label_values",
      "mcp__grafana-homelab__query_prometheus",
      "mcp__grafana-homelab__list_loki_label_names",
      "mcp__grafana-homelab__list_loki_label_values",
      "mcp__grafana-homelab__query_loki_stats",
      "mcp__grafana-homelab__query_loki_logs",
      "Read(//Users/yoshintame/**)"
    ],
    "deny": [
      "Read(//Users/yoshintame/Backups/**)",
      "Read(//Users/yoshintame/.config/resticprofile/**)",
      "Edit(//Users/yoshintame/.claude/projects/**/memory/**)",
      "Write(//Users/yoshintame/.claude/projects/**/memory/**)",
      "Edit(//Users/yoshintame/.dotfiles/modules/home/claude/config/settings.json)",
      "Write(//Users/yoshintame/.dotfiles/modules/home/claude/config/settings.json)",
      "Edit(//Users/yoshintame/.claude/settings.json)",
      "Write(//Users/yoshintame/.claude/settings.json)",
      "Edit(//Users/yoshintame/.claude/settings.local.json)",
      "Write(//Users/yoshintame/.claude/settings.local.json)",
      "Read(//Users/yoshintame/.ssh/**)",
      "Read(//Users/yoshintame/.gnupg/**)",
      "Read(//Users/yoshintame/.aws/**)",
      "Read(//Users/yoshintame/.config/gh/**)",
      "Edit(//Users/yoshintame/.claude/skills/**)",
      "Write(//Users/yoshintame/.claude/skills/**)",
      "Edit(//Users/yoshintame/.agents/skills/**)",
      "Write(//Users/yoshintame/.agents/skills/**)",
      "mcp__paseo__respond_to_permission"
    ],
    "ask": [
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(git push:*)",
      "Bash(gh gist:*)",
      "Bash(gh auth:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/yoshintame/Development",
      "/Users/yoshintame/.local/share/worktrees",
      "/Users/yoshintame/.dotfiles",
      "/Users/yoshintame/Documents/obsidian/yoshintame",
      "/Users/yoshintame/.claude",
      "/tmp",
      "/private/tmp",
      "/Users/yoshintame/.claude/handoffs/-Users-yoshintame-Documents-obsidian-yoshintame"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c --arg ts \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" '{ts: $ts, tool: .tool_name, input: .tool_input, session: .session_id, mode: .permission_mode, suggestions: .permission_suggestions}' >> \"$HOME/.claude/permission-requests.jsonl\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-title.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/curl-to-webfetch.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tool-steering.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/commit-attribution-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/restic-lock-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-clone-layout.sh",
            "if": "Bash(git clone *)"
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/chrome-cdp-ensure.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/cross-repo-claude-md.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree-create.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "worktrunk@worktrunk": false,
    "fallow@fallow-skills": true,
    "serena@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "fallow-skills": {
      "source": {
        "source": "github",
        "repo": "fallow-rs/fallow-skills"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "*.senateexchange.com",
        "www.reddit.com",
        "oauth.reddit.com"
      ],
      "allowUnixSockets": [],
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.FSEvents"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Development",
        "~/.paseo/worktrees",
        "~/Documents/obsidian/yoshintame",
        "~/.local/share/Trash",
        "~/.bun",
        "~/.local/share/pnpm",
        "~/.cache/search-reddit",
        "~/.cache/uv",
        "/tmp",
        "/private/tmp",
        "/var/folders",
        "/private/var/folders"
      ],
      "denyWrite": [
        "~/Backups"
      ],
      "denyRead": [
        "~/Backups",
        "~/.config/resticprofile",
        "~/.ssh",
        "~/.gnupg"
      ]
    },
    "excludedCommands": [
      "docker *",
      "bun run storybook",
      "bun run storybook *",
      "pnpm run start",
      "pnpm run start *",
      "pnpm run dev",
      "pnpm run dev *",
      "pnpm exec playwright *",
      "pnpm run test:e2e *",
      "ssh *",
      "scp *",
      "sftp *",
      "rsync *",
      "yt-dlp *",
      "act *",
      "git-commit-atomic *",
      "git -C * commit-atomic *",
      "bun *link-and-open.ts",
      "ps *",
      "bun *reset-sessions.ts*",
      "bun *append-custom-title.ts*",
      "gh *",
      "search-reddit *",
      "search-github *",
      "search-hn *",
      "bun run dev",
      "bun run dev *",
      "bun run dev:local",
      "bun run dev:local *",
      "wt dev",
      "wt dev *",
      "wt dev:local",
      "wt dev:local *"
    ],
    "env": {
      "BUN_TMPDIR": "/tmp",
      "BUN_INSTALL_CACHE_DIR": "/Users/yoshintame/.bun/install/cache"
    }
  },
  "effortLevel": "xhigh",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "console-ninja": {
      "command": "npx",
      "args": [
        "-y",
        "-c",
        "node ~/.console-ninja/mcp/"
      ]
    }
  },
  "trustedDirectories": [
    "/Users/yoshintame/Development",
    "/Users/yoshintame/.dotfiles",
    "/Users/yoshintame/.local/share/worktrees",
    "/Users/yoshintame/Documents/obsidian/yoshintame"
  ],
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control (replaces the default Source control entry): GitHub accounts github.com/yoshintame (personal), github.com/senate-exchange (work org) and github.com/stainwood (org the user administers), and all repos under them. Public repos under these accounts still count as publishing. Content from senate-exchange repos must not go to yoshintame or stainwood repos, or the other way round, unless the user names the destination. Org-level admin actions (settings, branch protection, members, permissions) still follow the default rules.",
      "Trusted internal domains (replaces the default entry): senateexchange.com and *.senateexchange.com",
      "Backups: restic repositories are managed by resticprofile (rp is a wrapper around it); the local hub is ~/Backups/restic/main, offsite copies live on the homelab rest-server and in Backblaze B2. Backup data is irreplaceable.",
      "Homelab: user-owned NixOS server lasthaze-homelab (root@lasthaze-homelab.alpine-ulmer.ts.net, 100.123.237.27 over Tailscale, 192.168.1.48 on LAN), configured from ~/Development/personal/lasthaze-homelab. Routine work there: deploys of that repo, service restarts, and read or inspect commands. Copying files to the host is not exfiltration. Deleting data on the host (it also stores the offsite restic rest-server), changing firewall, SSH or Tailscale access, and editing credentials still follow the default rules."
    ],
    "soft_deny": [
      "$defaults",
      "Backup Destruction [must name: the operation and the repository or resticprofile profile; naming a profile counts as naming its repository; group or all-profile runs need the group named or an explicit all]: restic, resticprofile or rp forget, prune, rewrite, tag --remove, unlock --remove-all, repair, key remove, key passwd, or init over an existing repository; editing resticprofile retention, keep-*, prune or schedule settings and then running backup; deleting ~/Backups/restic, the B2 bucket contents (b2, rclone) or the rest-server data directory on the homelab by any route. Dry runs (--dry-run), snapshots, check without repair, stats, ls, diff and restore into a new path are fine."
    ]
  }
}
