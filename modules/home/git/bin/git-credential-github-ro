#!/usr/bin/env bash
#
# Owner-routing credential helper for github.com.
# Routes read-only fine-grained PATs by repository owner.
#
# Keychain layout: internet-password per owner
#   srvr=github.com  ptcl=htps  acct=<username>  path=/<owner>
#
# Requires [credential "https://github.com"] useHttpPath = true

operation="${1:-}"
[[ "$operation" =~ ^(get|store|erase)$ ]] || exit 0

protocol= host= path= username= password=
while IFS='=' read -r key value; do
    case "$key" in
        protocol) protocol="$value" ;;
        host)     host="$value" ;;
        path)     path="$value" ;;
        username) username="$value" ;;
        password) password="$value" ;;
    esac
done

[[ "$host" == "github.com" && "$protocol" == "https" ]] || exit 0

owner="${path%%/*}"
[[ -n "$owner" ]] || exit 0

: "${username:=yoshintame}"

case "$operation" in
    get)
        pw=$(security find-internet-password -s github.com -r htps -a "$username" -p "/$owner" -w 2>/dev/null) || \
        pw=$(security find-internet-password -s github.com -r htps -a "$username" -w 2>/dev/null) || exit 0
        printf 'protocol=https\nhost=github.com\nusername=%s\npassword=%s\n' "$username" "$pw"
        ;;
    store)
        [[ -n "$password" ]] || exit 0
        security add-internet-password -U -s github.com -r htps -a "$username" -p "/$owner" \
            -w "$password" -l "github.com/$owner (read-only PAT)" 2>/dev/null || true
        ;;
    erase)
        security delete-internet-password -s github.com -r htps -a "$username" -p "/$owner" 2>/dev/null || true
        ;;
esac
