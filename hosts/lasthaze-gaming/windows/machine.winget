$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: WingetMachineScope
    type: Microsoft.WinGet/UserSettingsFile
    properties:
      action: Partial
      settings:
        installBehavior:
          preferences:
            scope: machine

  - name: VirtualMachinePlatform
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        @{ state = (Get-WindowsOptionalFeature -Online -FeatureName VirtualMachinePlatform).State.ToString() }
      testScript: |
        (Get-WindowsOptionalFeature -Online -FeatureName VirtualMachinePlatform).State -eq 'Enabled'
      setScript: |
        Enable-WindowsOptionalFeature -Online -FeatureName VirtualMachinePlatform -All -NoRestart | Out-Null
    metadata:
      winget:
        securityContext: elevated

  - name: Wsl
    type: Microsoft.WinGet/Package
    dependsOn:
      - VirtualMachinePlatform
    properties:
      id: Microsoft.WSL
      source: winget
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

  - name: Steam
    type: Microsoft.WinGet/Package
    dependsOn:
      - WingetMachineScope
    properties:
      id: Valve.Steam
      source: winget
      acceptAgreements: true
    metadata:
      winget:
        securityContext: elevated

