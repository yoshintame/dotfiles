  - name: HackNerdFont
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        $dir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
        @{ files = @(Get-ChildItem $dir -Filter 'HackNerdFontMono-*.ttf' -ErrorAction SilentlyContinue | ForEach-Object Name) }
      testScript: |
        $dir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
        $key = 'HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
        $fonts = @{
          'Hack Nerd Font Mono (TrueType)' = 'HackNerdFontMono-Regular.ttf'
          'Hack Nerd Font Mono Bold (TrueType)' = 'HackNerdFontMono-Bold.ttf'
          'Hack Nerd Font Mono Italic (TrueType)' = 'HackNerdFontMono-Italic.ttf'
          'Hack Nerd Font Mono Bold Italic (TrueType)' = 'HackNerdFontMono-BoldItalic.ttf'
        }
        foreach ($name in $fonts.Keys) {
          $path = Join-Path $dir $fonts[$name]
          if (-not (Test-Path $path)) { return $false }
          if ((Get-ItemProperty $key -Name $name -ErrorAction SilentlyContinue).$name -ne $path) { return $false }
        }
        $true
      setScript: |
        $ErrorActionPreference = 'Stop'
        $version = '3.5.1'
        $sha256 = 'FA24DA7DE7CEFE7766614D27762570B20453C852FC1D5B657111666DF9A5E449'
        $dir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
        $key = 'HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
        $fonts = @{
          'Hack Nerd Font Mono (TrueType)' = 'HackNerdFontMono-Regular.ttf'
          'Hack Nerd Font Mono Bold (TrueType)' = 'HackNerdFontMono-Bold.ttf'
          'Hack Nerd Font Mono Italic (TrueType)' = 'HackNerdFontMono-Italic.ttf'
          'Hack Nerd Font Mono Bold Italic (TrueType)' = 'HackNerdFontMono-BoldItalic.ttf'
        }
        $zip = Join-Path $env:TEMP "Hack-$version.zip"
        $unpacked = Join-Path $env:TEMP "Hack-$version"
        Invoke-WebRequest -UseBasicParsing -Uri "https://github.com/ryanoasis/nerd-fonts/releases/download/v$version/Hack.zip" -OutFile $zip
        if ((Get-FileHash $zip -Algorithm SHA256).Hash -ne $sha256) { throw "Hack.zip $version does not match its pinned SHA256" }
        Expand-Archive -Force $zip $unpacked
        New-Item -ItemType Directory -Force $dir | Out-Null
        if (-not (Test-Path $key)) { New-Item $key | Out-Null }
        Add-Type -Namespace Native -Name Fonts -MemberDefinition '[DllImport("gdi32.dll", CharSet = CharSet.Unicode)] public static extern int AddFontResourceW(string file); [DllImport("user32.dll")] public static extern IntPtr SendMessageTimeoutW(IntPtr hWnd, uint msg, UIntPtr wParam, IntPtr lParam, uint flags, uint timeout, out UIntPtr result);'
        foreach ($name in $fonts.Keys) {
          $path = Join-Path $dir $fonts[$name]
          Copy-Item -Force (Join-Path $unpacked $fonts[$name]) $path
          Set-ItemProperty $key -Name $name -Value $path
          [void][Native.Fonts]::AddFontResourceW($path)
        }
        $result = [UIntPtr]::Zero
        [void][Native.Fonts]::SendMessageTimeoutW([IntPtr]0xffff, 0x001D, [UIntPtr]::Zero, [IntPtr]::Zero, 2, 1000, [ref]$result)
        Remove-Item -Recurse -Force $zip, $unpacked

  - name: Dotbot
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    dependsOn:
      - Mise
    properties:
      getScript: |
        @{ repo = Join-Path $env:USERPROFILE '.dotfiles' }
      testScript: |
        $false
      setScript: |
        $ErrorActionPreference = 'Continue'
        $mise = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\mise.exe'
        $repo = Join-Path $env:USERPROFILE '.dotfiles'
        & $mise exec uv@0.13.1 -- uv tool run --python 3.14 dotbot==1.24.0 -d $repo -c (Join-Path $repo 'hosts\lasthaze-gaming\windows\links.yaml')
        if ($LASTEXITCODE -ne 0) { throw "dotbot exited with $LASTEXITCODE" }

  - name: MiseTools
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    dependsOn:
      - Dotbot
    properties:
      getScript: |
        $ErrorActionPreference = 'Continue'
        $mise = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\mise.exe'
        @{ missing = if (Test-Path $mise) { @(& $mise ls --global --missing 2>$null) } else { $null } }
      testScript: |
        $ErrorActionPreference = 'Continue'
        $mise = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\mise.exe'
        if (-not (Test-Path $mise)) { return $false }
        $missing = & $mise ls --global --missing 2>$null
        -not $missing
      setScript: |
        $ErrorActionPreference = 'Continue'
        $mise = Join-Path $env:LOCALAPPDATA 'Microsoft\WinGet\Links\mise.exe'
        & $mise install --yes
        if ($LASTEXITCODE -ne 0) { throw "mise install exited with $LASTEXITCODE" }
