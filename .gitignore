.DS_Store
.clj-kondo
.lsp
modules/git/config/config-sber
modules/git/config/config-vtb

# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# git-hooks.nix installs this into the working tree on devShell entry
.pre-commit-config.yaml

# Claude permission analyzer backups
modules/claude/config/settings.backup-*.json

# VSCode workspace state (was polluted by markdown-inline-preview extension)
/.vscode/

node_modules

# Python bytecode cache (analyze-permissions script)
__pycache__/
*.pyc

# Decrypted SOPS render — real secrets, must never be tracked.
# The live config renders to ~/.config/resticprofile/profiles.yaml;
# this repo copy is a stray that leaked healthchecks UUIDs to the public
# mirror. Ignored so `dot:rebuild`'s `git add -A` can't re-stage it.
modules/resticprofile/config/profiles.yaml
