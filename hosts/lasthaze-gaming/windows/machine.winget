        securityContext: elevated

  - name: OpenSshServer
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        @{ capability = (Get-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0').State.ToString(); service = (Get-Service sshd -ErrorAction SilentlyContinue).StartType }
      testScript: |
        $service = Get-Service sshd -ErrorAction SilentlyContinue
        $service -and $service.StartType -eq 'Automatic' -and $service.Status -eq 'Running'
      setScript: |
        if ((Get-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0').State -ne 'Installed') {
            Add-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0' | Out-Null
        }
        Set-Service sshd -StartupType Automatic
        Start-Service sshd
    metadata:
      winget:
        securityContext: elevated

  - name: SshAdministratorsAuthorizedKeys
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    dependsOn:
      - OpenSshServer
    properties:
      getScript: |
        $file = 'C:\ProgramData\ssh\administrators_authorized_keys'
        @{ content = if (Test-Path $file) { (Get-Content $file -Raw).Trim() } else { $null } }
      testScript: |
        $file = 'C:\ProgramData\ssh\administrators_authorized_keys'
        $key = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJz1+EB4G3BZUXHDTrLCmRVFUnzEuKbSO5zIwKWGl0ev yoshintame-mbp'
        (Test-Path $file) -and (Get-Content $file -Raw).Trim() -eq $key
      setScript: |
        $file = 'C:\ProgramData\ssh\administrators_authorized_keys'
        $key = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJz1+EB4G3BZUXHDTrLCmRVFUnzEuKbSO5zIwKWGl0ev yoshintame-mbp'
        Set-Content -Path $file -Value $key -Encoding ascii
        icacls.exe $file /inheritance:r /grant '*S-1-5-32-544:F' /grant '*S-1-5-18:F' | Out-Null
    metadata:
      winget:
        securityContext: elevated

  - name: SshdKeyOnlyAuth
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    dependsOn:
      - OpenSshServer
    properties:
      getScript: |
        @{ lines = @(Select-String -Path 'C:\ProgramData\ssh\sshd_config' -Pattern '^(PasswordAuthentication|KbdInteractiveAuthentication) ' | ForEach-Object Line) }
      testScript: |
        $lines = Get-Content 'C:\ProgramData\ssh\sshd_config'
        ($lines -contains 'PasswordAuthentication no') -and ($lines -contains 'KbdInteractiveAuthentication no')
      setScript: |
        $cfg = 'C:\ProgramData\ssh\sshd_config'
        $lines = @(Get-Content $cfg | Where-Object { $_ -notmatch '^#?(PasswordAuthentication|KbdInteractiveAuthentication) ' })
        $lines = @('PasswordAuthentication no', 'KbdInteractiveAuthentication no') + $lines
        $lines | Set-Content $cfg -Encoding ascii
        Restart-Service sshd
    metadata:
      winget:
        securityContext: elevated

  - name: SshDefaultShell
    type: Microsoft.Windows/Registry
    dependsOn:
      - OpenSshServer
    properties:
      keyPath: HKLM\SOFTWARE\OpenSSH
      valueName: DefaultShell
      valueData:
        String: C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
    metadata:
      winget:
        securityContext: elevated

  - name: SshFirewallTailscaleOnly
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    dependsOn:
      - OpenSshServer
    properties:
      getScript: |
        $rule = Get-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue
        @{ exists = [bool]$rule; remote = if ($rule) { @(($rule | Get-NetFirewallAddressFilter).RemoteAddress) } else { @() } }
      testScript: |
        $rule = Get-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue
        if (-not $rule) { return $false }
        $remote = @(($rule | Get-NetFirewallAddressFilter).RemoteAddress) | Sort-Object
        ($remote -join ',') -eq (@('100.64.0.0/255.192.0.0', 'fd7a:115c:a1e0::/48') | Sort-Object) -join ','
      setScript: |
        if (-not (Get-NetFirewallRule -Name OpenSSH-Server-In-TCP -ErrorAction SilentlyContinue)) {
            New-NetFirewallRule -Name OpenSSH-Server-In-TCP -DisplayName 'OpenSSH Server (sshd)' -Direction Inbound -Protocol TCP -LocalPort 22 -Action Allow | Out-Null
        }
        Set-NetFirewallRule -Name OpenSSH-Server-In-TCP -Enabled True -RemoteAddress 100.64.0.0/10, fd7a:115c:a1e0::/48
    metadata:
      winget:
        securityContext: elevated

  - name: EthernetWakeOnMagicPacketOnly
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        @{ adapters = @(Get-NetAdapter -Physical | Where-Object MediaType -eq '802.3' | Get-NetAdapterPowerManagement | Select-Object Name, WakeOnMagicPacket, WakeOnPattern) }
      testScript: |
        $pm = @(Get-NetAdapter -Physical | Where-Object MediaType -eq '802.3' | Get-NetAdapterPowerManagement)
        $pm.Count -gt 0 -and -not ($pm | Where-Object { $_.WakeOnMagicPacket -ne 'Enabled' -or $_.WakeOnPattern -ne 'Disabled' })
      setScript: |
        Get-NetAdapter -Physical | Where-Object MediaType -eq '802.3' | Set-NetAdapterPowerManagement -WakeOnMagicPacket Enabled -WakeOnPattern Disabled
    metadata:
      winget:
        securityContext: elevated

  - name: NoSleepOnAc
    type: Microsoft.DSC.Transitional/WindowsPowerShellScript
    properties:
      getScript: |
        @{ standby = (powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE | Select-String 'Current AC').ToString().Trim(); hibernate = (powercfg /query SCHEME_CURRENT SUB_SLEEP HIBERNATEIDLE | Select-String 'Current AC').ToString().Trim() }
      testScript: |
        $standby = (powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE | Select-String 'Current AC').ToString()
        $hibernate = (powercfg /query SCHEME_CURRENT SUB_SLEEP HIBERNATEIDLE | Select-String 'Current AC').ToString()
        $standby -match '0x00000000$' -and $hibernate -match '0x00000000$'
      setScript: |
        powercfg /change standby-timeout-ac 0
        powercfg /change hibernate-timeout-ac 0
    metadata:
      winget:
        securityContext: elevated
