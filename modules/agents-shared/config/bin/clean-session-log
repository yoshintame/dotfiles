#!/usr/bin/env bun
let input = process.argv[2]
  ? await Bun.file(process.argv[2]).text()
  : await new Response(Bun.stdin.stream()).text()

input = input.replace(/\r\n/g, '\n')                 // normalize line endings first

const OSC = /\x1b\][\s\S]*?(?:\x07|\x1b\\)/g          // OSC 0/7/8/133, BEL- or ST-terminated
const CSI = /\x1b\[[0-?]*[ -/]*[@-~]/g               // incl private <=>? and intermediates
const CHARSET = /\x1b[()*+][@-~]/g                    // ESC ( B  etc.
const SIMPLE = /\x1b[=>78Mc]/g                        // keypad, save/restore, etc.
const STRAY = /\x1b[@-_]/g                            // any remaining ESC+one

const afterLastCR = (l: string) => { const i = l.lastIndexOf('\r'); return i < 0 ? l : l.slice(i + 1) }
const applyBS = (l: string) => { let p; do { p = l; l = l.replace(/[^\x08]\x08/g, '') } while (l !== p); return l.replace(/\x08+/g, '') }

const out: string[] = []
for (const raw of input.split('\n')) {
  let line = raw.replace(OSC, '').replace(CSI, '').replace(CHARSET, '').replace(SIMPLE, '').replace(STRAY, '')
  line = applyBS(afterLastCR(line)).replace(/[ \t]+$/, '')
  if (/^Script (started|done) on /.test(line)) continue
  if (/^Connection to .+ closed\.?$/.test(line)) continue
  if (/using configuration file/.test(line)) continue
  if (/\d{1,3}%/.test(line) && /[\d.]+\s*[KMGTP]?i?B\/s/.test(line)) continue
  out.push(line)
}
process.stdout.write(out.join('\n').replace(/\n{3,}/g, '\n\n').replace(/^\n+/, '').replace(/\n+$/, '\n'))
