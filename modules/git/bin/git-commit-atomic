#!/usr/bin/env bash
# git-commit-atomic: stage + commit specified paths atomically, race-safe.
# Usage: git-commit-atomic <message> <path>...
set -uo pipefail

[ $# -lt 2 ] && { echo "Usage: git-commit-atomic <message> <path>..." >&2; exit 2; }
MSG="$1"; shift
ERR=$(mktemp)
trap "rm -f $ERR" EXIT

i=0
while [ $i -lt 50 ]; do
    if git add -- "$@" 2>"$ERR" && git commit -m "$MSG" -- "$@" 2>"$ERR"; then
        exit 0
    fi
    if grep -qE "index\.lock|cannot lock ref" "$ERR"; then
        sleep 0.05; i=$((i+1)); continue
    fi
    cat "$ERR" >&2; exit 1
done
echo "git-commit-atomic: lock retry exhausted after $i attempts" >&2
exit 1
