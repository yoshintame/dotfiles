[
  // Task
  {
    "key": "cmd+t",
    "command": "workbench.action.tasks.runTask"
  },

  // Git Project Manager
  {
    "key": "cmd+o",
    "command": "gitProjectManager.openProjectNewWindow"
  },
  {
    "key": "alt+cmd+n",
    "command": "-gitProjectManager.openProjectNewWindow"
  },

  // Terminal tab actions
  {
    "key": "cmd+t",
    "command": "workbench.action.terminal.new",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.kill",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+1",
    "command": "workbench.action.terminal.focusAtIndex1",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+2",
    "command": "workbench.action.terminal.focusAtIndex2",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+3",
    "command": "workbench.action.terminal.focusAtIndex3",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+4",
    "command": "workbench.action.terminal.focusAtIndex4",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+5",
    "command": "workbench.action.terminal.focusAtIndex5",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+6",
    "command": "workbench.action.terminal.focusAtIndex6",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+7",
    "command": "workbench.action.terminal.focusAtIndex7",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+8",
    "command": "workbench.action.terminal.focusAtIndex8",
    "when": "focusedView == terminal"
  },
  {
    "key": "cmd+9",
    "command": "workbench.action.terminal.focusAtIndex9",
    "when": "focusedView == terminal"
  },

  // Explorer file/folder actions
  {
    "key": "n",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "shift+n",
    "command": "explorer.newFolder",
    "when": "explorerViewletFocus && !inputFocus"
  },
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "y",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && !inputFocus"
  },

  // Other
  {
    "key": "enter",
    "command": "closeFindWidget",
    "when": "editorFocus && findWidgetVisible && !isComposing"
  },

  // Camel case navigation (built-in since VS Code v1.25, replaces maptz.camelcasenavigation)
  {
    "key": "alt+left",
    "command": "cursorWordPartLeft",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+shift+left",
    "command": "cursorWordPartLeftSelect",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+right",
    "command": "cursorWordPartRight",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+shift+right",
    "command": "cursorWordPartRightSelect",
    "when": "editorTextFocus"
  },

  // Rename symbol
  {
    "key": "cmd+r",
    "command": "editor.action.rename",
    "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "f2",
    "command": "-editor.action.rename",
    "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
  },

  // Refactor
  {
    "key": "shift+cmd+r",
    "command": "editor.action.refactor",
    "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly"
  },

  // Restart vscode
  {
    "key": "shift+alt+r",
    "command": "workbench.action.reloadWindow"
  },

  // Comment line — bind to physical Slash key so it works on non-Latin layouts
  {
    "key": "cmd+[Slash]",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+[Slash]",
    "command": "editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },

  // Find by arrows
  {
    "key": "alt+down",
    "command": "-history.showNext",
    "when": "historyNavigationForwardsEnabled && historyNavigationWidgetFocus && !isComposing && !suggestWidgetVisible"
  },
  {
    "key": "alt+down",
    "command": "editor.action.nextMatchFindAction",
    "when": "historyNavigationForwardsEnabled && historyNavigationWidgetFocus && !isComposing && !suggestWidgetVisible"
  },
  {
    "key": "alt+up",
    "command": "-history.showPrevious",
    "when": "historyNavigationBackwardsEnabled && historyNavigationWidgetFocus && !isComposing && !suggestWidgetVisible"
  },
  {
    "key": "alt+up",
    "command": "editor.action.previousMatchFindAction",
    "when": "historyNavigationBackwardsEnabled && historyNavigationWidgetFocus && !isComposing && !suggestWidgetVisible"
  },

  // Which key
  {
    "key": "ctrl+shift+alt+cmd+l",
    "command": "whichkey.show"
  },

  // Open
  {
    "key": "shift+cmd+o",
    "command": "workbench.action.files.openFileFolder",
    "when": "isMacNative && openFolderWorkspaceSupport"
  },

  // Search in files
  {
    "key": "cmd+shift+f",
    "command": "workbench.action.findInFiles"
  },

  // Git diff view
  {
    "key": "cmd+g",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closePanel",
        "workbench.view.scm",
        "git.openChange"
      ]
    }
  },

  // Git graph
  {
    "key": "shift+cmd+g",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closePanel",
        "workbench.view.scm",
        "git-graph.view"
      ]
    }
  },

  // Toggle maximized panel (close when visible, open maximized when hidden)
  {
    "key": "cmd+j",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.toggleMaximizedPanel",
        "workbench.action.closePanel"
      ]
    },
    "when": "panelVisible"
  },
  {
    "key": "cmd+j",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "!panelVisible"
  },

  // Open File explorer, if already opened - focus active file. If opening from git diff, then open diffing file in editor
  {
    "key": "cmd+e",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closePanel",
        "workbench.view.explorer",
        "git.openFile"
      ]
    }
  },
  {
    "key": "cmd+e",
    "command": "workbench.files.action.showActiveFileInExplorer",
    "when": "filesExplorerFocus"
  },

  // Toggle md tab between text editor and default editor (InLineMd WYSIWYG).
  // Claude Code opens file links via showTextDocument, which always uses the
  // text editor and bypasses workbench.editorAssociations — since bridge 0.6.0
  // such tabs are autoflipped to WYSIWYG; this bridge-aware toggle marks the
  // uri as "user wants text" so the autoflip doesn't fight a manual switch.
  {
    "key": "cmd+m",
    "command": "inlinemdBridge.toggleEditorType",
    "when": "resourceExtname =~ /\\.mdx?$/"
  },

  // Git diff for md tabs — rendered diff instead of text diff. Goes through
  // the bridge trampoline because diff extensions resolve the target from
  // activeTextEditor, which is undefined in the InLineMd custom tab. The
  // actual diff tool is set by inlinemdBridge.renderedDiffCommand (default:
  // markdownDiffVisualiser.showChanges).
  {
    "key": "cmd+g",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closePanel",
        "workbench.view.scm",
        "inlinemdBridge.showRenderedGitDiff"
      ]
    },
    "when": "resourceExtname =~ /\\.mdx?$/"
  },

  // =============================================
  // VSCode-specific bindings
  // =============================================

  // Open Claude Code sidebar.
  // Note: in the InLineMd WYSIWYG webview the keybinding system cannot reach
  // here because ProseMirror's keymap captures Cmd+I (italic) at the iframe's
  // keydown bubble phase. The inlinemd-claude-bridge patch installs a
  // document-level capture-phase listener inside the webview that hijacks
  // Cmd+I before ProseMirror sees it, posts to the host, and the host fires
  // inlinemdBridge.insertAtMention directly — no keybinding entry needed for
  // the WYSIWYG case.
  {
    "key": "cmd+i",
    "command": "claude-vscode.focus"
  },
  {
    "key": "cmd+z",
    "command": "-undo",
    "when": "focusedView == claudeVSCodeSidebar"
  },
  {
    "key": "cmd+z",
    "command": "-undo",
    "when": "focusedView == claudeVSCodeSidebarSecondary"
  },

  // Open Codex sidebar (mirrors Claude Code cmd+i — opens view + attaches editor selection)
  // chatgpt.addToThread already calls the open/focus routine internally and queues
  // the selection until the webview is ready, so no runCommands wrapper is needed.
  {
    "key": "cmd+l",
    "command": "chatgpt.addToThread"
  },

  // =============================================
  // Cursor-specific bindings
  // =============================================

  // Unbind Cursor defaults
  {
    "key": "cmd+l",
    "command": "-aichat.newchataction"
  },
  {
    "key": "cmd+i",
    "command": "-composerMode.agent"
  },

  // =============================================
  // Unbind defaults (shared)
  // =============================================

  {
    "key": "cmd+g",
    "command": "-editor.action.nextMatchFindAction",
    "when": "editorFocus"
},
{
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\u001b\r"
    },
    "when": "terminalFocus"
}
]
